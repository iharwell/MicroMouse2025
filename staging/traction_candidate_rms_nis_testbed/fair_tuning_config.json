      "parameters": {
        "peak_friction_coefficient_at_80pct_fan": 1.72,
        "dynamic_to_static_grip_ratio": 0.82,
        "stribeck_velocity_mps": 0.16,
        "viscous_slip_damping_n_per_mps": 2.0,
        "low_speed_blend_mps": 0.06
